#set( $CLASS = $Class_Name)
#set( $BUTTONS = $Buttons__r_Right__b_Botton__Blank_for_no_buttons.toLowerCase())
## ----------------
##
## ----- Valid Button orientation: -----
#if( $BUTTONS == 'b' || $BUTTONS == 'r')
<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>$CLASS</class>
 <widget class="QDialog" name="$CLASS">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>400</width>
    <height>300</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>$CLASS Dialog autogenerated with '$BUTTONS' button orientation</string>
  </property>
  <widget class="QDialogButtonBox" name="buttonBox">
   <property name="geometry">
    <rect>
#if($BUTTONS == 'b')
     <x>30</x>
     <y>240</y>
     <width>341</width>
     <height>32</height>
#else
     <x>290</x>
     <y>20</y>
     <width>81</width>
     <height>241</height>
#end
    </rect>
   </property>
   <property name="orientation">
    <enum>#if( $BUTTONS == 'b')Qt::Horizontal#{else}Qt::Vertical#end</enum>
   </property>
   <property name="standardButtons">
    <set>QDialogButtonBox::Cancel|QDialogButtonBox::Ok</set>
   </property>
  </widget>
 </widget>
 <resources/>
 <connections>
  <connection>
   <sender>buttonBox</sender>
   <signal>accepted()</signal>
   <receiver>Dialog</receiver>
   <slot>accept()</slot>
   <hints>
    <hint type="sourcelabel">
     <x>248</x>
     <y>254</y>
    </hint>
    <hint type="destinationlabel">
     <x>157</x>
     <y>274</y>
    </hint>
   </hints>
  </connection>
  <connection>
   <sender>buttonBox</sender>
   <signal>rejected()</signal>
   <receiver>Dialog</receiver>
   <slot>reject()</slot>
   <hints>
    <hint type="sourcelabel">
     <x>316</x>
     <y>260</y>
    </hint>
    <hint type="destinationlabel">
     <x>286</x>
     <y>274</y>
    </hint>
   </hints>
  </connection>
 </connections>
</ui>
##
## ----- Blank or other, use no buttons: -----
#else
<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>$CLASS</class>
 <widget class="QDialog" name="$CLASS">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>400</width>
    <height>300</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>$CLASS Dialog autogenerated#if( $BUTTONS != "") WARNING: invalid button orientation '$BUTTONS', defaulting to without buttons layout.#end</string>
  </property>
 </widget>
 <resources/>
 <connections/>
</ui>
#end